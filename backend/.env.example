PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@pokedex-data.grdqpdm.mongodb.net/pokemon?appName=pokedex-data
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2
# R2_PUBLIC_URL — the public CDN URL of your R2 bucket (used by the API at runtime)
#   e.g. https://pub-XXXX.r2.dev  OR  https://images.yourdomain.com (custom domain)
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# R2 credentials — only needed when running upload-images-to-r2.js locally
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pokedex-images

# Keep-alive
# How often (in hours) the server issues a real read against MongoDB so an
# Atlas free-tier (M0) cluster never reaches "60 days idle" and auto-pauses.
# Set to 0 to disable the job. Default: 12
KEEP_ALIVE_INTERVAL_HOURS=12
